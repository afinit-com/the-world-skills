{
  "_comment": "The one app a harness needs. It is the main persona (socket owner); every other persona posts through it under its own name and icon (chat:write.customize), and channels:join lets it enter a public channel without an invite. A persona that wants its own Slack app instead: drop event subscriptions, socket mode, and interactivity — posting-only needs just chat:write + reactions:write. bin/slack-provision.py renders both kinds from this file.",
  "display_information": {
    "name": "{{Prefix}}-{{MainPersona}}",
    "description": "{{one-line description of the bots in the world's voice}}"
  },
  "features": {
    "bot_user": {
      "display_name": "{{Prefix}}-{{MainPersona}}",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "chat:write",
        "chat:write.customize",
        "channels:join",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels", "message.groups"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
