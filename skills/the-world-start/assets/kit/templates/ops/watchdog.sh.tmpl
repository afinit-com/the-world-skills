#!/usr/bin/env bash
# {{NAME}}-watchdog — run every {{INTERVAL_S}}s by launchd or a systemd user timer.
#
# Each round, under the same ops lock as `{{NAME}}-up up/down` (bin/ops-lock.py): if the
# harness is not running and was not stopped on purpose (`{{NAME}}-up down`), start it
# again. A harness that keeps dying is retried with exponential backoff,
# {{BACKOFF_MIN_S}}s doubling to {{BACKOFF_MAX_S}}s, and the count resets once a round
# finds it running. A harness running without its console writer is restarted. Everything
# it does goes to logs/watchdog.log{{NOTIFY_NOTE}}. The console log is not touched here;
# its writer rolls it (bin/ops-log.py).
#
# One outage is one incident: it opens the first round that finds the harness down (or
# cannot tell) and closes the first round that finds it running again. With Slack on, an
# incident is one message, and every later line about it is a reply in that thread.
#
# Rendered by bin/ops-kit.py from the kit's templates/ops/. Re-render rather than edit.
set -uo pipefail

HOME_DIR={{HOME_DIR}}
PY={{PYTHON}}
UP={{UP}}
SELF={{WATCHDOG}}
LOGS="$HOME_DIR/logs"
STATE="$LOGS/.watchdog"
LOG="$LOGS/watchdog.log"
# Present while an incident is open; holds the ts of its Slack thread, if it has one yet.
INCIDENT="$STATE/incident"
BACKOFF_MIN_S={{BACKOFF_MIN_S}}
BACKOFF_MAX_S={{BACKOFF_MAX_S}}
KEEP_DAYS={{KEEP_DAYS}}  # empty: rolled logs are never deleted
NOTIFY={{NOTIFY}}        # empty: no Slack message, watchdog.log only

mkdir -p "$STATE"

# The whole round holds the lock. A `down` in progress holds it too, for up to its drain
# wait, so a round that cannot get it within 30s is skipped; the next one comes soon.
if [ "${WORLD_OPS_LOCK_HELD:-}" != "$HOME_DIR" ]; then
  WORLD_OPS_LOCK_HELD="$HOME_DIR" exec "$PY" "$HOME_DIR/bin/ops-lock.py" "$STATE/lock" \
    --wait-s 30 -- "$SELF"
fi

log() { printf '%s %s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$*" >>"$LOG"; }

# Log a line and, with Slack on, post it: into the open incident's thread, or as a new
# message that becomes the thread. ops-notify prints the thread it landed in, a new one
# when the old thread no longer takes replies.
notify() {
  log "$*"
  [ -n "$NOTIFY" ] || return 0
  local thread ts
  thread=$(cat "$INCIDENT" 2>/dev/null || true)
  # shellcheck disable=SC2086  # NOTIFY is the two --*-env flags, word-split on purpose
  if ! ts=$("$PY" "$HOME_DIR/bin/ops-notify.py" $NOTIFY ${thread:+--thread-ts "$thread"} \
      "{{NAME}} watchdog: $*" 2>>"$LOG"); then
    log "⚠️  Slack notification failed (see the line above); the event is only in this log"
    return 0
  fi
  if [ -n "$ts" ] && [ -f "$INCIDENT" ]; then echo "$ts" >"$INCIDENT"; fi
}

# Only watchdog rounds write this log, one at a time under the lock, so rolling it by
# rename between rounds loses nothing.
"$PY" "$HOME_DIR/bin/ops-log.py" --file "$LOG" --roll-only --err-file "$LOGS/ops-log.err" \
  ${KEEP_DAYS:+--keep-days "$KEEP_DAYS"} >>"$LOG" 2>&1

# Lines the console writer could not write (a full disk, a read-only file): restarting
# would not help, so say it once each time it starts happening.
if [ -f "$LOGS/.console.out.dropping" ]; then
  if [ ! -f "$STATE/reported-dropping" ]; then
    notify "the console writer is dropping lines: $(cat "$LOGS/.console.out.dropping")"
    touch "$STATE/reported-dropping"
  fi
else
  rm -f "$STATE/reported-dropping"
fi

# Failures, including an unreadable process list, share the same retry schedule.
set_retry() {
  [ "${retry_scheduled:-0}" = 1 ] && return 0
  failures=$(cat "$STATE/failures" 2>/dev/null || echo 0)
  failures=$((failures + 1))
  delay=$BACKOFF_MIN_S
  i=1
  while [ "$i" -lt "$failures" ] && [ "$delay" -lt "$BACKOFF_MAX_S" ]; do
    delay=$((delay * 2))
    i=$((i + 1))
  done
  [ "$delay" -gt "$BACKOFF_MAX_S" ] && delay=$BACKOFF_MAX_S
  echo "$failures" >"$STATE/failures"
  echo $((now + delay)) >"$STATE/next_try"

  retry_scheduled=1
}

open_incident() { [ -f "$INCIDENT" ] || : >"$INCIDENT"; }

# A failure is posted when the state changes, not again every round it stays the same;
# the log still gets every round.
notify_state() {
  local key=$1
  shift
  open_incident
  if [ "$(cat "$STATE/reported-failure" 2>/dev/null)" != "$key" ]; then
    notify "$*"
    echo "$key" >"$STATE/reported-failure"
  else
    log "$* (posted already)"
  fi
}

# A restart that worked is posted every time: a harness that dies again before the next
# round shows up as one reply per restart, not as one reassuring message.
notify_restart() {
  local key=$1
  shift
  open_incident
  notify "$*"
  echo "$key" >"$STATE/reported-failure"
}

check_unknown() {
  [ "$1" = 4 ] || return 0
  if [ "${retry_scheduled:-0}" != 1 ] && [ "$now" -lt "$next_try" ]; then exit 0; fi
  set_retry
  notify_state "unknown-$2" "stopped this round: '$2' could not tell or could not finish (exit 4); see $LOG"
  exit 4
}

now=$(date +%s)
next_try=$(cat "$STATE/next_try" 2>/dev/null || echo 0)

# Their output is why a round could not tell (a pgrep failure), so it goes to the log the
# notification points at, as everything resume and recycle print does.
"$UP" running >>"$LOG" 2>&1
running_rc=$?
check_unknown "$running_rc" running
if [ "$running_rc" = 0 ]; then
  # Running without its console writer: the harness's next line of output fails with
  # EPIPE and kills it at a moment nobody chose, so restart it now instead.
  "$UP" healthy >>"$LOG" 2>&1
  healthy_rc=$?
  check_unknown "$healthy_rc" healthy
  if [ "$healthy_rc" != 0 ] && [ ! -f "$STATE/down" ]; then
    [ "$now" -lt "$next_try" ] && exit 0
    set_retry
    "$UP" recycle >>"$LOG" 2>&1
    recycle_rc=$?
    check_unknown "$recycle_rc" recycle
    if [ "$recycle_rc" = 0 ]; then
      notify_restart recycled "its console writer had died; restarted the harness before its output could kill it"
    else
      notify_state recycle-failed "its console writer had died and restarting the harness failed; see $LOG"
    fi
    exit 0
  fi
  rm -f "$STATE/reported-failure"
  if [ -f "$INCIDENT" ] || [ -f "$STATE/failures" ]; then
    again="running again after $(cat "$STATE/failures" 2>/dev/null || echo 0) restart(s)"
    if [ -f "$INCIDENT" ]; then
      notify "recovered: $again; this incident is closed"
      rm -f "$INCIDENT"
    else
      log "$again"
    fi
    rm -f "$STATE/failures" "$STATE/next_try"
  fi
  exit 0
fi

# Stopped on purpose. Read under the lock, so a `down` either finished before this
# round (marker present) or starts after it.
[ -f "$STATE/down" ] && exit 0

[ "$now" -lt "$next_try" ] && exit 0
set_retry

# `resume`, never `up`: only a person's explicit `up` clears the down marker.
"$UP" resume >>"$LOG" 2>&1
resume_rc=$?
check_unknown "$resume_rc" resume
if [ "$resume_rc" = 0 ]; then
  notify_restart restarted "found it not running; restarted (attempt $failures; next retry no sooner than ${delay}s)"
else
  notify_state start-failed "found it not running and could not start it (attempt $failures; retrying in ${delay}s). See $LOGS/console.out"
fi
